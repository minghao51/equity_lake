# Equity Lake environment template
# Copy to `.env` and fill only the values you need.
#
# Settings are loaded from config/settings.yaml first, then overridden by
# environment variables using the EQUITY_ prefix with __ as nested delimiter.
# Priority: init args > env vars > .env file > config/settings.yaml defaults
#
# Examples:
#   EQUITY_MONITORING__MAX_AGE_DAYS=2
#   EQUITY_SCHEDULE__CRON=0 1 * * 1-5
#   EQUITY_DASHBOARD__TITLE=Equity Lake

# =============================================================================
# Monitoring (equity monitor) — freshness/quality expectations
# =============================================================================
# Default max data age (days) for price markets and the feature store.
EQUITY_MONITORING__MAX_AGE_DAYS=2
# Max null % of close/volume before a data-quality alert.
EQUITY_MONITORING__NULL_THRESHOLD_PCT=5.0
# Per price-market freshness overrides (JSON dict); markets not listed fall
# back to EQUITY_MONITORING__MAX_AGE_DAYS.
# EQUITY_MONITORING__MARKET_MAX_AGE_DAYS={"krx_equity": 3}
# Per-table freshness expectations for the unstructured check (JSON dict):
# news/articles daily, SEC extractions quarterly. Tables not listed fall back
# to EQUITY_MONITORING__MAX_AGE_DAYS. Defaults shown; uncomment to override.
# EQUITY_MONITORING__TABLE_MAX_AGE_DAYS={"bronze/raw_articles": 2, "silver/processed_articles": 2, "silver/sec_extractions": 95}

# =============================================================================
# Project
# =============================================================================
EQUITY_PROJECT__ENVIRONMENT=development

# =============================================================================
# Schedule overrides
# =============================================================================
EQUITY_SCHEDULE__CRON=0 1 * * 1-5
EQUITY_SCHEDULE__TIMEZONE=Asia/Singapore

# =============================================================================
# Dashboard overrides
# =============================================================================
EQUITY_DASHBOARD__OUTPUT_DIR=site

# =============================================================================
# S3-compatible object storage bootstrap
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=s3://your-bucket/path/

# Max seconds to wait for a single s5cmd/AWS sync subprocess.
# Large historical syncs may need more than the 600s default.
# EQUITY_S3_SYNC__TIMEOUT_SECONDS=600

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=

# =============================================================================
# Market / macro APIs
# =============================================================================
FRED_API_KEY=

# =============================================================================
# Finnhub news + social sentiment
# =============================================================================
FINNHUB_API_KEY=

# =============================================================================
# DeepSeek LLM (unstructured data enrichment)
# =============================================================================
DEEPSEEK_API_KEY=

# =============================================================================
# OpenRouter embeddings (RAG vector index — qwen/qwen3-embedding-8b)
# =============================================================================
OPENROUTER_API_KEY=

# =============================================================================
# StockTwits (API registrations frozen — disabled by default)
# Set STOCKTWITS_ENABLED=true to attempt API calls
# =============================================================================
STOCKTWITS_ENABLED=false
STOCKTWITS_ACCESS_TOKEN=

# =============================================================================
# Reddit (unauthenticated .json endpoint — 10 req/min)
# User-Agent MUST follow format: <platform>:<app>:<version> (by u/<username>)
# =============================================================================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=macos:equity-lake:1.0 (by u/your_reddit_username)

# =============================================================================
# SEC loader identity
# =============================================================================
SEC_USER_AGENT=Equity Lake contact@example.com

# =============================================================================
# Macro toggles
# =============================================================================
ENABLE_MACRO_INDICATORS=true
MACRO_INDICATORS=dxy,treasury_10y,tips_yield,breakeven_inflation,vix,gld,iau,policy_uncertainty

# =============================================================================
# Weights & Biases registry (ml/registry.py — best-effort logging adapter)
# NOTE: these are RAW/unprefixed on purpose. They are read via os.getenv at the
# wandb client seam and are deliberately NOT declared in Settings (which is
# extra="forbid"). When WANDB_API_KEY is unset, logging is a silent no-op.
# =============================================================================
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=
